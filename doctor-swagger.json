        "additionalProperties": false,
        "description": "A single insurance verification event."
      },
      "LoginRequestDto": {
        "required": [
          "nationalId",
          "password"
        ],
        "type": "object",
        "properties": {
          "nationalId": {
            "minLength": 1,
            "pattern": "^\\d{14}$",
            "type": "string",
            "description": "Egyptian National ID of the account to log in as. Required, exactly 14\r\n            digits.",
            "example": "29801011234567"
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "description": "Account password, in plain text over HTTPS. Required.",
            "example": "SecurePass@123"
          }
        },
        "additionalProperties": false,
        "description": "Request payload for logging in. Works for any role (Patient, Doctor, Admin)."
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
