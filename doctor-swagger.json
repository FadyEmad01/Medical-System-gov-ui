  "tags": [
    {
      "name": "Authentication",
      "description": "**Frontend flow:** Register (once) → Login → receive a JWT → send it as `Authorization: Bearer <token>` on every other Domain 1 call."
    },
    {
      "name": "Insurance Eligibility",
      "description": "**Admin-only.** Records a citizen's national health-insurance eligibility outcome, used as a read-only snapshot when an application is finally decided."
    },
    {
      "name": "Insurance Verification",
      "description": "**Frontend flow:** A doctor or admin verifies a citizen's coverage at the point of care (appointment, check-in, billing) and records the outcome."
    },
    {
      "name": "Digital Insurance Card",
      "description": "**Frontend flow:** Once an application is Approved, Admin issues a card → citizen/provider can fetch or verify it by its QR/NFC token."
    }
  ]
}