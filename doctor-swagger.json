      "TestTokenRequestDto": {
        "required": [
          "nationalId"
        ],
        "type": "object",
        "properties": {
          "nationalId": {
            "minLength": 1,
            "pattern": "^\\d{1,14}$",
            "type": "string",
            "description": "NationalId of any seeded or registered account (Patient, Doctor, or Admin). Unlike Register/Login,\r\nthis does not require exactly 14 digits - this endpoint is Development-only, so a short id is\r\nfine for quick manual testing."
          }
        },
        "additionalProperties": false,
        "description": "Request payload for the development-only test-token endpoint. No password required."
      },
      "UserRole": {
        "enum": [
          "Patient",
          "Doctor",
          "Admin"
        ],
        "type": "string",
        "description": "Role assigned to an authenticated user, included as a claim in the issued JWT."
      },
      "VerificationContext": {
        "enum": [
          "Appointment",
          "CheckIn",
          "ClinicVisit",
          "EmergencyAdmission",
          "Billing"
        ],
        "type": "string",
        "description": "Which operational workflow prompted an insurance verification. Values: Appointment, CheckIn,\r\nClinicVisit, EmergencyAdmission, Billing. A closed, curated set on purpose - if a new business\r\ncontext appears, add a new value rather than falling back to a generic \"Other\"."
      },
      "VerificationSource": {
        "enum": [
          "Manual",
          "GovernmentApi",
          "Imported",
          "System"
        ],
        "type": "string",
        "description": "Where a verification decision came from. Values: Manual, GovernmentApi, Imported, System. Only\r\nManual is produced today - no external integration exists yet. Kept independent from\r\nEligibilitySource (not reused) since the two features may evolve this concept differently over time."
      },
      "VerificationStatus": {
        "enum": [
          "Verified",
          "NotVerified",
          "Pending"
        ],
        "type": "string",
        "description": "The outcome of a single insurance verification event, decided at the moment it was checked.\r\n            Values: Verified, NotVerified, Pending."
      },
      "VerifyCardRequestDto": {
        "required": [
          "verificationToken"
        ],
        "type": "object",
        "properties": {
          "verificationToken": {
            "type": "string",
            "description": "Required. The opaque secret decoded from the card's QR/NFC payload.",
            "format": "uuid",
            "example": "0f1e2d3c-4b5a-6978-8f0e-1d2c3b4a5968"
          }
        },
        "additionalProperties": false,
        "description": "Request payload for the hospital-facing verify endpoint - a scanned QR/NFC decodes to this\r\n            token, never raw card data."
      },
      "VerifyInsuranceRequestDto": {
        "required": [
          "context",
          "patientId",
          "reason",
          "status"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "description": "Required. Must reference an existing patient.",
            "format": "int32",
            "example": 1
          },
          "status": {
            "$ref": "#/components/schemas/VerificationStatus"
          },
          "context": {
            "$ref": "#/components/schemas/VerificationContext"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
            "description": "Required, max 500 characters.",
            "example": "Confirmed active coverage via national insurance portal."
          },
          "remarks": {
            "maxLength": 1000,
            "type": "string",
            "description": "Optional, max 1000 characters.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Request payload for recording an insurance verification decision. Status/Reason/Context are\r\nsupplied by the calling Doctor or Admin - this sprint does not call an external source. Source is\r\nset internally by the service (always Manual); ExpiresAt is computed internally from\r\nInsurance:Verification:DefaultValidityHours (24 hours by default) - neither is accepted from the\r\nclient."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter a JWT token. Example: \"Bearer eyJhbGciOi...\" (the \"Bearer \" prefix is added automatically).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
