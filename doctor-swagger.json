          "remarks": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "description": "Null if this is the first decision ever recorded for this patient.",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "A patient's current national health insurance eligibility state."
      },
      "InsuranceVerificationResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "patientFullName": {
            "type": "string",
            "nullable": true,
            "example": "Ahmed Mohamed Ali Hassan"
          },
          "patientNationalId": {
            "type": "string",
            "nullable": true,
            "example": "29801011234567"
          },
          "status": {
            "$ref": "#/components/schemas/VerificationStatus"
          },
          "context": {
            "$ref": "#/components/schemas/VerificationContext"
          },
          "source": {
            "$ref": "#/components/schemas/VerificationSource"
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "example": "Confirmed active coverage via national insurance portal."
          },
          "remarks": {
            "type": "string",
            "nullable": true
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "description": "Set only when Status is Verified - computed from\r\n            Insurance:Verification:DefaultValidityHours (24 hours by default) at the moment of\r\n            verification.",
            "format": "date-time",
            "nullable": true
          },
          "verifiedBy": {
            "type": "integer",
            "description": "DoctorId or AdminId of whoever performed this verification.",
            "format": "int32",
