          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "isCurrentlyValid": {
            "type": "boolean",
            "description": "Computed by the service, never the client: true when Status is Verified and ExpiresAt\r\n            (if set) has not yet passed."
