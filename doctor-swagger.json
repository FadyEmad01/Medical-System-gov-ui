          },
          "username": {
            "type": "string",
            "nullable": true,
            "example": "ahmed.hassan"
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "example": "Ahmed Mohamed Ali Hassan"
          },
          "role": {
            "type": "string",
            "description": "\"Patient\", \"Doctor\", or \"Admin\", read directly from the JWT's role claim.",
            "nullable": true,
            "example": "Patient"
          }
        },
        "additionalProperties": false,
        "description": "Response for GET /api/auth/me, reflecting the claims present in the caller's JWT."
      },
      "ProblemDetails": {
        "type": "object",
